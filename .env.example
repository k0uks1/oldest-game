# Kopieren nach .env (wird nicht committet) und Key eintragen.
# `npm start` bzw. `docker compose up -d` lesen diese Datei; der Key erreicht nie den Browser.
ANTHROPIC_API_KEY=

# ── Eigener Server (Docker) ──────────────────────────────────────────────
# Empfohlen, wenn der Server öffentlich erreichbar ist: ohne Code kein Raum.
ACCESS_CODE=
# Obergrenze für Züge mit Claude pro Stunde (alle Räume zusammen) – deckelt die API-Kosten.
# CLAUDE_MOVES_PER_HOUR=600
# MAX_ROOMS=200

# HTTPS mit eigener Domain (Caddy holt das Zertifikat selbst; Ports 80/443 müssen frei sein):
# COMPOSE_PROFILES=https
# DOMAIN=spiel.example.de
# TRUST_PROXY=1
# GAME_PORT=127.0.0.1:8080

# ── Optional ─────────────────────────────────────────────────────────────
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_MAX_TOKENS=800
# PORT=5173
