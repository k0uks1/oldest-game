{
  "name": "oldest-game",
  "version": "0.66.1",
  "private": true,
  "description": "The Oldest Game – ein Duell der Vorstellungskraft für zwei Spieler. Deterministische Regel-Engine, Pixel-Arena, Claude Haiku als Erzähler und Klassifikator.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx scripts/build.ts && tsx server/local.ts",
    "dev": "tsx scripts/build.ts --serve",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "art": "tsx scripts/art.ts",
    "scenery": "tsx scripts/scenery.ts",
    "effects": "tsx scripts/effects.ts",
    "rooms": "tsx scripts/rooms.ts",
    "audit": "tsx scripts/audit.ts",
    "sheet": "tsx scripts/sheet.ts",
    "simulate": "tsx scripts/simulate.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run secret-scan && npm run spec",
    "spec": "openspec validate --all --strict --no-interactive",
    "backlog": "tsx scripts/backlog.ts",
    "preview": "tsx scripts/build.ts --artifact",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "duel": "tsx scripts/duel.ts",
    "judge-eval": "tsx scripts/judge-eval.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@fission-ai/openspec": "^1.13.2",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "dependencies": {
    "pixi.js": "^8.21.0",
    "ws": "^8.22.0"
  }
}
